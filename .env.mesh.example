# ─── Private (mesh-only) instance: journal.curlyphries.space ─────────────────
# Copy to .env.mesh and fill in. Used by docker-compose.mesh.yml.
# See docs/MESH_DEPLOYMENT.md.
#
# docker compose reads ${VARS} in the compose file from the shell or from a
# file passed with --env-file, so start the stack with:
#   docker compose --env-file .env.mesh -p dj-mesh -f docker-compose.mesh.yml up -d --build

# ─── Secrets (generate fresh ones; do not reuse the public instance's) ───────
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_hex(32))"
# Back this up. Without it every journal entry is unreadable, permanently.
ENCRYPTION_ROOT_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MESH_POSTGRES_PASSWORD=

# ─── Host name ────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=journal.curlyphries.space
CORS_ALLOWED_ORIGINS=https://journal.curlyphries.space
FRONTEND_URL=https://journal.curlyphries.space

# ─── Who may connect ──────────────────────────────────────────────────────────
# Addresses allowed to use the site. Default: the Tailscale ranges + loopback.
# For another mesh (WireGuard, ZeroTier, Nebula...) put its subnet here.
MESH_ALLOWED_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.0/8,::1/128

# ─── AI: local only ───────────────────────────────────────────────────────────
# Cloud providers are refused on this instance (AI_LOCAL_ONLY is forced on in
# the compose file). Point at an Ollama on this host or elsewhere on the mesh.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Scripture ────────────────────────────────────────────────────────────────
# Public-domain translations, in order of preference. Load them into the local
# database so no lookup leaves the server:
#   docker compose -p dj-mesh -f docker-compose.mesh.yml exec mesh-backend python manage.py load_translation WEB
SCRIPTURE_TRANSLATIONS=WEB,KJV

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# No mail server needed: sign-in links are printed to the worker log
# (docker compose -p dj-mesh -f docker-compose.mesh.yml logs -f mesh-celery).
# Anyone who can read that log can sign in - fine on a box only you administer.
MAGIC_LINK_LOG=true
EMAIL_HOST=localhost
DEFAULT_FROM_EMAIL=journal@curlyphries.space
# Google sign-in is optional; leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://journal.curlyphries.space/api/v1/auth/google/callback/

# ─── Host proxy ───────────────────────────────────────────────────────────────
MESH_FRONTEND_PORT=3011
