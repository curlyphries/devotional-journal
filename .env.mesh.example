# ─── Private (mesh-only) instance: devotional-journal.curlyphries.space ─────────────────
# Copy to .env.mesh and fill in. Used by docker-compose.mesh.yml.
# See docs/MESH_DEPLOYMENT.md.
#
# docker compose reads ${VARS} in the compose file from the shell or from a
# file passed with --env-file, so start the stack with:
#   docker compose --env-file .env.mesh -p dj-mesh -f docker-compose.mesh.yml up -d --build

# ─── Secrets (generate fresh ones; do not reuse the public instance's) ───────
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_hex(32))"
# Back this up. Without it every journal entry is unreadable, permanently.
ENCRYPTION_ROOT_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MESH_POSTGRES_PASSWORD=

# ─── Host name ────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=devotional-journal.curlyphries.space
CORS_ALLOWED_ORIGINS=https://devotional-journal.curlyphries.space
FRONTEND_URL=https://devotional-journal.curlyphries.space

# ─── Who may connect ──────────────────────────────────────────────────────────
# Addresses allowed to use the site. Default: the Tailscale ranges + loopback.
# For another mesh (WireGuard, ZeroTier, Nebula...) put its subnet here.
MESH_ALLOWED_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.0/8,::1/128

# ─── AI: local only ───────────────────────────────────────────────────────────
# Cloud providers are refused on this instance (AI_LOCAL_ONLY is forced on in
# the compose file). Point at an Ollama on this host or elsewhere on the mesh.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Scripture ────────────────────────────────────────────────────────────────
# Public-domain translations, in order of preference. Load them into the local
# database so no lookup leaves the server:
#   docker compose -p dj-mesh -f docker-compose.mesh.yml exec mesh-backend python manage.py load_translation WEB
SCRIPTURE_TRANSLATIONS=WEB,KJV

# ─── Sign-in email: the curlyphries.space mail server ─────────────────────────
# Sign-in links are emailed through this mail server. Fill in the mailbox
# password, and correct the host name or port if your mail server differs
# (port 465 instead of 587 switches to TLS-from-the-start by itself).
# Then check it:  ... exec mesh-backend python manage.py send_test_email you@curlyphries.space
# Full guide and every failure explained: docs/SIGNING_IN.md
EMAIL_HOST=mail.curlyphries.space
EMAIL_PORT=587
EMAIL_HOST_USER=devotional-journal@curlyphries.space
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Devotional Journal <devotional-journal@curlyphries.space>

# Also write each sign-in link to the worker log. Keep this on until the test
# email arrives, so you are never locked out; then set it to false - anyone
# who can read the log can use a link.
MAGIC_LINK_LOG=true

# Anyone who can reach this (mesh-only) site may register with their own email
# address. Set to false to create every account yourself with create_user.
ALLOW_EMAIL_SIGNUP=true

# Google sign-in is optional; leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://devotional-journal.curlyphries.space/api/v1/auth/google/callback/

# ─── Host proxy ───────────────────────────────────────────────────────────────
# Where the frontend container is published. Loopback when the TLS proxy runs
# on this machine (deploy/mesh/nginx-*.conf); this host's own mesh address
# (e.g. 100.x.y.z) when the TLS proxy is another node on the mesh. Never a
# public address.
MESH_FRONTEND_BIND=127.0.0.1
MESH_FRONTEND_PORT=3011
# Name the backend announces to the mail server (SMTP EHLO).
MESH_HOSTNAME=devotional-journal.curlyphries.space
