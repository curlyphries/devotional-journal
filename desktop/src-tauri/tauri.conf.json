{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devotional Journal",
  "version": "0.1.0",
  "identifier": "com.curlyphries.devotional",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Devotional Journal",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8001 https://devotional-api.example.com; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/kjv.sqlite"
    ],
    "copyright": "Copyright (c) 2026 curlyphries",
    "category": "Productivity",
    "shortDescription": "Offline-first devotional journaling",
    "longDescription": "A privacy-first, offline-capable desktop companion to the Devotional Journal web app. Write, reflect, and sync seamlessly.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "14.0",
      "license": "LICENSE",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.0-37", "libsqlite3-0"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:main.db"]
    },
    "updater": {
      "active": false
    }
  }
}
